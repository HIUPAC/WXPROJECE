:host { display: block; position: sticky; top: 0; z-index: 20; }
.header { background: #fff; border-bottom: 1rpx solid #e3e7e1; }
.navigation { box-sizing: border-box; display: flex; align-items: center; padding-left: 36rpx; }
.brand-seal { display: flex; align-items: center; justify-content: center; width: 44rpx; height: 52rpx; }
.brand-copy { margin-left: 14rpx; min-width: 0; }
.title { color: #263b30; font-size: 30rpx; font-weight: 600; line-height: 1.3; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.subtitle { color: #68766a; font-size: 19rpx; margin-top: 3rpx; line-height: 1.3; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.navigation .back-button { display: flex; align-items: center; justify-content: center; flex: none; width: 64rpx; min-width: 0; max-width: 64rpx; height: 72rpx; padding: 0; margin: 0 0 0 -16rpx; border-radius: 8rpx; }
.back-button::after { border: 0; }
.press-feedback { opacity: .55; }
