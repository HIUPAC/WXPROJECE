.edit-profile-page { padding-top: 26rpx; }
.avatar-editor { display: flex; flex-direction: column; align-items: center; padding: 12rpx 0 30rpx; }
.avatar-choice { display: flex; align-items: center; justify-content: center; width: 136rpx; min-width: 136rpx; max-width: 136rpx; height: 136rpx; margin: 0; padding: 0; border-radius: 12rpx; overflow: hidden; background: #edf1eb; border: 2rpx solid #e3e7e1; transition: transform .16s ease, opacity .16s ease; }
.avatar-image { width: 100%; height: 100%; }
.avatar-letter { color: #244b3b; font-size: 58rpx; }
.avatar-caption { margin-top: 18rpx; font-size: 24rpx; color: #263b30; }
.avatar-reset { margin-top: 12rpx; padding: 9rpx 17rpx; border: 1rpx solid #e3e7e1; color: #244b3b; font-size: 21rpx; background: #fff; transition: transform .16s ease, opacity .16s ease; border-radius: 6rpx; }
.avatar-hint { margin-top: 12rpx; color: #68766a; font-size: 21rpx; }
.form-sheet { padding: 8rpx 26rpx; border: 1rpx solid #e3e7e1; background: #fff; border-radius: 12rpx; }
.form-field { padding: 23rpx 0; }
.form-field + .form-field { border-top: 1rpx solid #e3e7e1; }
.field-heading { display: flex; justify-content: space-between; align-items: center; }
.field-label { color: #263b30; font-size: 25rpx; }
.field-counter { color: #68766a; font-size: 21rpx; }
.field-input { width: 100%; height: 78rpx; margin-top: 15rpx; padding: 0 18rpx; border: 1rpx solid #e3e7e1; border-radius: 12rpx; background: #f6f7f4; font-size: 27rpx; color: #263b30; }
.field-hint { display: block; margin-top: 11rpx; color: #68766a; font-size: 21rpx; line-height: 1.8; }
.bio-input { width: 100%; height: 216rpx; padding: 17rpx 18rpx; border: 1rpx solid #e3e7e1; border-radius: 12rpx; background: #f6f7f4; margin-top: 15rpx; font-size: 26rpx; color: #263b30; line-height: 1.9; }
.account-sheet { margin: 22rpx 0 0; padding: 26rpx; background: #edf1eb; border-radius: 12rpx; border: 0; }
.account-heading { color: #244b3b; font-size: 24rpx; font-weight: 500; }
.account-row { display: flex; justify-content: space-between; gap: 18rpx; margin-top: 17rpx; font-size: 24rpx; color: #526553; flex-wrap: wrap; overflow-wrap: anywhere; }
.account-caption { display: block; margin-top: 17rpx; font-size: 21rpx; line-height: 1.8; color: #68766a; }
.form-error { display: block; margin-top: 20rpx; padding: 17rpx 22rpx; border-radius: 12rpx; background: #fbefea; color: #a44d46; font-size: 24rpx; line-height: 1.7; }
.relogin-button { margin-top: 22rpx; }
.save-button { margin-top: 26rpx; }
.save-caption { display: block; text-align: center; color: #68766a; font-size: 22rpx; margin-top: 20rpx; line-height: 1.8; }
.empty-title { display: block; color: #263b30; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif; font-size: 32rpx; font-weight: 600; }
.empty-copy { display: block; margin-top: 18rpx; font-size: 25rpx; line-height: 1.9; }
