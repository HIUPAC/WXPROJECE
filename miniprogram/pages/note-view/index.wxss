page { background: #fff; }
.note-reader { padding-top: 32rpx; padding-bottom: calc(60rpx + env(safe-area-inset-bottom)); background: #fff; }
.note-label { display: inline-block; background: #edf1eb; color: #526553; border: 0; border-radius: 6rpx; font-size: 21rpx; letter-spacing: 0; padding: 6rpx 12rpx; }
.reader-title { display: block; line-height: 1.55; word-break: break-all; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif; font-size: 40rpx; font-weight: 600; color: #263b30; margin: 22rpx 0 28rpx; }
.author-row { display: flex; align-items: center; gap: 16rpx; }
.author-row > view:last-child { min-width: 0; }
.author-avatar { flex-shrink: 0; width: 72rpx; height: 72rpx; border: 3rpx solid #e3e7e1; border-radius: 12rpx; }
.avatar-letter { display: flex; align-items: center; justify-content: center; background: #edf1eb; color: #244b3b; font-size: 31rpx; }
.author-name, .author-date { display: block; }
.author-name { font-size: 26rpx; color: #263b30; word-break: break-all; }
.author-date { margin-top: 5rpx; font-size: 21rpx; color: #68766a; }
.author-tags { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 20rpx; }
.author-tags text { padding: 5rpx 14rpx; color: #68766a; font-size: 21rpx; border-radius: 6rpx; background: #f6f7f4; border: 0; }
.author-bio { display: block; margin-top: 14rpx; font-size: 23rpx; line-height: 1.85; word-break: break-all; }
.related-reading { display: flex; align-items: center; gap: 12rpx; padding: 22rpx 24rpx; margin-top: 26rpx; border: 1rpx solid #e3e7e1; border-radius: 12rpx; background: #edf1eb; color: #244b3b; text-align: left; font-size: 24rpx; line-height: 1.75; transition: transform 160ms ease, opacity 160ms ease; }
.related-reading text { flex: 1; min-width: 0; word-break: break-all; }
.related-reading app-icon { flex-shrink: 0; }
.reader-body { padding: 32rpx 0; border: 0; border-top: 1rpx solid #e3e7e1; border-bottom: 1rpx solid #e3e7e1; border-radius: 0; margin: 28rpx 0; background: transparent; }
.reader-paragraph { display: block; margin-bottom: 28rpx; color: #263b30; font-size: 29rpx; line-height: 2; word-break: break-all; }
.reader-paragraph:last-child { margin-bottom: 0; }
.reader-metrics { display: flex; gap: 0; margin-bottom: 18rpx; font-size: 22rpx; line-height: 1.8; color: #68766a; border: 0; border-radius: 0; background: transparent; padding: 16rpx 0; }
.reader-stat { flex: 1; min-width: 0; padding: 0 8rpx; text-align: center; }
.reader-stat + .reader-stat { border-left: 1rpx solid #e3e7e1; }
.reader-stat-value { display: block; color: #244b3b; font-size: 34rpx; line-height: 1.35; font-variant-numeric: tabular-nums; word-break: break-all; overflow-wrap: anywhere; }
.reader-stat-label { display: block; margin-top: 8rpx; color: #68766a; font-size: 20rpx; line-height: 1.5; }
.view-recording { min-height: 36rpx; padding: 0 4rpx; color: #526553; font-size: 21rpx; }
.view-retry { padding: 8rpx 12rpx; margin-left: -12rpx; border-radius: 12rpx; color: #a44d46; font-size: 21rpx; text-align: left; transition: transform 160ms ease, opacity 160ms ease; }
.view-rule { display: block; padding: 0 4rpx; margin-top: 8rpx; font-size: 20rpx; line-height: 1.85; }
.social-actions { display: flex; gap: 12rpx; margin-top: 24rpx; border: 0; border-radius: 0; background: transparent; padding: 0; }
.social-actions button { flex: 1; min-width: 0; min-height: 94rpx; padding: 14rpx 8rpx; border-radius: 12rpx; font-size: 23rpx; background: #f6f7f4; border-color: #e3e7e1; }
.social-actions .reaction-button { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8rpx; }
.reaction-icon { display: flex; align-items: center; justify-content: center; min-height: 38rpx; }
.social-actions .reaction-button app-icon { margin-left: 0; }
.reaction-label { display: block; max-width: 100%; line-height: 1.45; font-variant-numeric: tabular-nums; text-align: center; word-break: break-all; overflow-wrap: anywhere; }
.social-actions .active-action { color: #244b3b; background: #edf1eb; border-color: #a7b8aa; }
.reaction-error { display: block; margin-top: 16rpx; padding: 16rpx 20rpx; border: 1rpx solid #ead5ce; border-radius: 12rpx; background: #fbefea; color: #a44d46; font-size: 22rpx; line-height: 1.75; }
.reaction-retry { color: #806138; font-weight: 500; }
.owner-actions { padding-top: 26rpx; margin-top: 30rpx; border-top: 1rpx solid #e3e7e1; }
.delete-button { width: 100%; padding: 18rpx 24rpx; margin-top: 16rpx; border: 1rpx solid #ead5ce; border-radius: 12rpx; background: #fff; color: #a44d46; font-size: 24rpx; transition: transform 160ms ease, opacity 160ms ease; }
.login-hint { display: block; padding: 0 4rpx; margin-top: 20rpx; font-size: 22rpx; line-height: 1.85; }
.empty-state .text-link { justify-content: center; margin-top: 24rpx; }
.report-panel { margin-top: 20rpx; }
.report-button { color: #68766a; font-size: 22rpx; text-align: left; padding: 12rpx 4rpx; }
.report-error { display: block; color: #a44d46; font-size: 22rpx; margin-top: 8rpx; line-height: 1.8; }
@media (max-width: 350px) { .reader-metrics { padding: 20rpx 8rpx; } .reader-stat { padding: 0 5rpx; } .reader-stat-value { font-size: 30rpx; } .reader-stat-label { font-size: 19rpx; } .social-actions { gap: 8rpx; padding: 8rpx; } .social-actions button { font-size: 21rpx; padding: 14rpx 5rpx; } }
