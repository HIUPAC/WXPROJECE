.profile-page { padding-top: 20rpx; padding-bottom: 56rpx; }
.profile-identity { position: relative; display: flex; align-items: center; gap: 22rpx; padding: 28rpx 0 30rpx; }
.profile-avatar { display: flex; align-items: center; justify-content: center; flex: 0 0 108rpx; width: 108rpx; min-width: 108rpx; max-width: 108rpx; height: 108rpx; margin: 0; padding: 0; border-radius: 12rpx; background: #edf1eb; border: 1rpx solid #e3e7e1; overflow: hidden; transition: transform .16s ease, opacity .16s ease; }
.avatar-image { width: 100%; height: 100%; }
.avatar-letter { color: #244b3b; font-size: 48rpx; }
.identity-copy { flex: 1; padding-top: 3rpx; min-width: 0; padding-right: 68rpx; }
.identity-copy .eyebrow { font-size: 21rpx; letter-spacing: 0; color: #68766a; }
.identity-name { display: block; margin-top: 9rpx; font-size: 36rpx; color: #263b30; overflow-wrap: anywhere; line-height: 1.45; font-family: inherit; font-weight: 600; }
.identity-caption { display: block; margin-top: 9rpx; font-size: 22rpx; color: #68766a; line-height: 1.7; overflow-wrap: anywhere; }
.guest-badge { position: absolute; top: 30rpx; right: 0; font-size: 21rpx; border: 0; background: transparent; color: #68766a; border-radius: 0; padding: 8rpx 0; line-height: 1.5; }
.edit-badge { color: #244b3b; transition: transform .16s ease, opacity .16s ease; }
.identity-tags { display: flex; flex-wrap: wrap; gap: 10rpx; margin: -9rpx 0 24rpx 130rpx; }
.identity-tag { background: #edf1eb; color: #526553; border-radius: 4rpx; padding: 6rpx 16rpx; font-size: 20rpx; }
.login-panel, .demo-notice { padding: 24rpx 0; margin-bottom: 24rpx; background: transparent; border: 0; border-radius: 0; border-top: 1rpx solid #e3e7e1; border-bottom: 1rpx solid #e3e7e1; }
.login-caption { display: block; color: #68766a; font-size: 23rpx; line-height: 1.8; }
.login-actions { display: flex; align-items: center; gap: 14rpx; margin-top: 14rpx; }
.login-actions .secondary-button { flex: 1; min-height: 76rpx; padding: 16rpx 20rpx; font-size: 25rpx; }
.profile-demo-button { width: 100%; margin-top: 20rpx; min-height: 84rpx; padding: 18rpx; font-size: 26rpx; }
.demo-notice { font-size: 22rpx; color: #68766a; line-height: 1.8; }
.demo-notice text { display: block; }
.demo-notice-title { color: #244b3b; font-size: 25rpx; margin-bottom: 9rpx; font-weight: 500; }
.demo-notice .text-link { margin-top: 16rpx; font-size: 23rpx; }
.profile-stats { display: flex; flex-wrap: wrap; padding: 12rpx 0; background: #fff; border: 1rpx solid #e3e7e1; border-radius: 12rpx; }
.stat-item { flex: 0 0 33.333%; width: 33.333%; min-width: 0; max-width: 33.333%; margin: 0; padding: 22rpx 0; background: transparent; line-height: 1.5; border-radius: 12rpx; box-sizing: border-box; transition: transform .16s ease, opacity .16s ease; }
.stat-item:not(:nth-child(3n)) { border-right: 1rpx solid rgba(36, 75, 59, .06); }
.stat-item:nth-child(-n+3) { border-bottom: 1rpx solid rgba(36, 75, 59, .06); }
.stat-value { font-family: inherit; display: block; font-size: 40rpx; color: #244b3b; line-height: 1.2; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
.stat-label { display: block; margin-top: 10rpx; font-size: 21rpx; color: #68766a; }
.note-impact { margin: 20rpx 0 0; padding: 24rpx 0; border: 0; border-radius: 0; background: transparent; border-bottom: 1rpx solid #e3e7e1; }
.impact-heading { display: flex; align-items: baseline; flex-wrap: wrap; gap: 10rpx 20rpx; justify-content: space-between; color: #263b30; font-size: 24rpx; }
.impact-status { color: #68766a; font-size: 19rpx; }
.impact-stats { display: flex; margin-top: 18rpx; }
.impact-item { flex: 1; padding: 5rpx 0; font-size: 20rpx; color: #68766a; border-radius: 0; transition: transform .16s ease, opacity .16s ease; min-width: 0; }
.impact-number { font-family: inherit; display: block; font-size: 35rpx; color: #244b3b; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
.impact-view-hint { display: block; margin-top: 14rpx; color: #68766a; font-size: 21rpx; line-height: 1.7; }
.stats-error { color: #a44d46; font-size: 22rpx; padding-top: 16rpx; text-align: left; }
.play-profile { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; padding: 22rpx 24rpx; margin: 24rpx 0 0; background: #edf1eb; border: 0; border-radius: 10rpx; text-align: left; line-height: 1.7; transition: transform .16s ease, opacity .16s ease; }
.play-profile-title { display: block; font-size: 28rpx; color: #244b3b; font-family: inherit; font-weight: 500; }
.play-profile-caption { display: block; margin-top: 7rpx; color: #68766a; font-size: 22rpx; }
.journal-banner { margin: 16rpx 0 0; display: flex; align-items: center; gap: 18rpx; background: transparent; border: 0; padding: 24rpx 0; border-radius: 0; transition: transform .16s ease, opacity .16s ease; border-bottom: 1rpx solid #e3e7e1; }
.journal-icon { display: flex; align-items: center; justify-content: center; width: 52rpx; height: 64rpx; border-radius: 0; background: transparent; flex-shrink: 0; }
.journal-copy { flex: 1; min-width: 0; }
.journal-title { font-family: inherit; font-weight: 500; display: block; color: #263b30; font-size: 26rpx; line-height: 1.6; }
.journal-subtitle { display: block; color: #68766a; font-size: 21rpx; margin-top: 6rpx; }
.journal-banner > app-icon { flex-shrink: 0; }
.community-link { justify-content: flex-end; gap: 9rpx; padding: 22rpx 3rpx 36rpx; font-size: 23rpx; }
.collection-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.collection-heading .section-heading { font-size: 32rpx; }
.collection-caption { font-size: 21rpx; color: #68766a; }
.collection-tabs { display: flex; gap: 20rpx; padding: 0; background: transparent; border: 0; border-radius: 0; margin-top: 16rpx; border-bottom: 1rpx solid #e3e7e1; }
.collection-tab { flex: 1; margin: 0; padding: 20rpx 0; line-height: 1.5; font-size: 24rpx; color: #68766a; border-radius: 0; background: transparent; transition: transform .16s ease, opacity .16s ease, background-color .2s ease; border-bottom: 4rpx solid transparent; }
.collection-tab text { font-size: 20rpx; margin-left: 5rpx; }
.collection-tab.selected { color: #244b3b; font-weight: 600; background: transparent; border-color: #244b3b; }
.collection-content { padding-top: 24rpx; }
.collection-content content-card { display: block; margin-bottom: 22rpx; }
.favorite-more { margin: 4rpx 0 28rpx; font-size: 24rpx; }
.favorite-end { display: block; text-align: center; margin: 8rpx 0 28rpx; font-size: 21rpx; }
.profile-empty { padding: 38rpx 20rpx 42rpx; }
.profile-empty > app-icon { display: block; margin-bottom: 19rpx; }
.empty-title { display: block; color: #263b30; font-size: 29rpx; }
.empty-copy { display: block; margin-top: 14rpx; line-height: 1.8; font-size: 23rpx; }
.empty-link { display: flex; align-items: center; justify-content: center; gap: 9rpx; margin-top: 24rpx; padding: 0; font-size: 24rpx; background: transparent; line-height: 1.5; }
.progress-card { display: flex; align-items: stretch; gap: 22rpx; padding: 22rpx 0; background: transparent; border: 0; border-radius: 0; margin-bottom: 18rpx; transition: transform .16s ease, opacity .16s ease; border-bottom: 1rpx solid #e3e7e1; }
.progress-image { flex-shrink: 0; width: 136rpx; height: 166rpx; border-radius: 8rpx; background: #edf1eb; }
.progress-info { flex: 1; min-width: 0; }
.course-category { display: block; font-size: 19rpx; color: #68766a; line-height: 1.5; }
.course-title { display: block; margin-top: 9rpx; font-size: 28rpx; color: #263b30; line-height: 1.5; font-family: inherit; font-weight: 500; }
.progress-track { margin-top: 20rpx; height: 7rpx; background: #edf1eb; border-radius: 8rpx; overflow: hidden; }
.progress-fill { height: 100%; background: #6d8b70; border-radius: 8rpx; }
.progress-caption { display: flex; flex-wrap: wrap; gap: 5rpx 12rpx; justify-content: space-between; margin-top: 12rpx; font-size: 19rpx; color: #68766a; }
.continue-study { color: #244b3b; }
.completed-status { display: flex; align-items: center; gap: 9rpx; margin-top: 16rpx; font-size: 21rpx; color: #526e5d; }
.review-link { display: block; font-size: 20rpx; color: #68766a; margin-top: 9rpx; }
.settings-list { padding: 0 24rpx; margin-top: 20rpx; border: 1rpx solid #e3e7e1; border-radius: 12rpx; background: #fff; }
.settings-row { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; padding: 26rpx 0; margin: 0; background: transparent; line-height: 1.5; border-radius: 0; text-align: left; transition: transform .16s ease, opacity .16s ease; min-height: 100rpx; }
.settings-row + .settings-row { border-top: 1rpx solid rgba(36, 75, 59, .07); }
.settings-name { display: flex; align-items: center; gap: 20rpx; min-width: 0; }
.settings-name app-icon { flex-shrink: 0; }
.settings-title { display: block; color: #263b30; font-size: 26rpx; }
.settings-description { display: block; margin-top: 7rpx; color: #68766a; font-size: 21rpx; }
.local-caption { display: block; margin-top: 25rpx; color: #68766a; font-size: 21rpx; line-height: 1.8; text-align: left; padding: 0 4rpx; }
.profile-footer { margin-top: 38rpx; text-align: center; color: #68766a; }
.profile-footer .serif { display: block; font-size: 24rpx; font-family: inherit; }
.footer-label { display: block; margin-top: 12rpx; font-size: 20rpx; letter-spacing: 0; color: #68766a; }

.storage-card, .storage-notice { background: #edf1eb; border-radius: 0; padding: 22rpx 24rpx; margin: 22rpx 0; color: #263b30; border-left: 4rpx solid #a8b8a3; }
.storage-card-title, .storage-notice-title { display: block; font-size: 26rpx; font-weight: 500; line-height: 1.6; }
.storage-card-copy, .storage-notice-copy { display: block; font-size: 22rpx; line-height: 1.85; color: #68766a; margin-top: 8rpx; }
.storage-card button, .local-entry { display: block; text-align: left; font-size: 23rpx; color: #244b3b; margin-top: 12rpx; padding: 8rpx 0; }
.profile-stats .stat-item { flex-basis: 25%; width: 25%; max-width: 25%; border: 0; }
.profile-stats .stat-item + .stat-item { border-left: 1rpx solid #e3e7e1; }
.interaction-links { display: flex; gap: 12rpx; margin-top: 20rpx; }
.interaction-links button { flex: 1; color: #35624c; background: #edf1eb; border-radius: 6rpx; padding: 14rpx 10rpx; font-size: 23rpx; min-height: 72rpx; font-variant-numeric: tabular-nums; }


.impact-item + .impact-item { border-left: 1rpx solid #e3e7e1; }

@media (max-width: 350px) { .identity-name { font-size: 32rpx; } .collection-tab { font-size: 22rpx; } .stat-value { font-size: 36rpx; } }
